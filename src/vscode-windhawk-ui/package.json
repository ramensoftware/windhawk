  "scripts": {
    "start": "nx serve",
    "watch": "nx build --configuration=development --watch",
    "build": "nx build",
    "build-ext": "nx build vscode-windhawk-ui --configuration=production",
    "build-website": "cross-env BUILD_MODE=website nx build vscode-windhawk-ui --configuration=production",
    "start-website": "cross-env BUILD_MODE=website nx serve vscode-windhawk-ui",
    "build-tauri": "cross-env BUILD_MODE=tauri nx build vscode-windhawk-ui --configuration=production",
    "test": "nx test",
    "build-css": "less-watch-compiler --enable-js --run-once --main-file=app.less apps/vscode-windhawk-ui/src/app/ apps/vscode-windhawk-ui/src/app/",
    "watch-css": "npm run build-css && less-watch-compiler --enable-js --main-file=app.less apps/vscode-windhawk-ui/src/app/ apps/vscode-windhawk-ui/src/app/"
  },
