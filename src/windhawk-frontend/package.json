{
  "name": "windhawk-frontend-nx",
  "version": "2.0.0-alpha.3",
  "scripts": {
    "start": "nx serve",
    "watch": "nx build --configuration=development --watch",
    "build": "nx build",
    "build-ext": "nx build windhawk-frontend --configuration=production",
    "build-website": "cross-env BUILD_MODE=website nx build windhawk-frontend --configuration=production",
    "start-website": "cross-env BUILD_MODE=website nx serve windhawk-frontend",
    "build-tauri": "cross-env BUILD_MODE=tauri nx build windhawk-frontend --configuration=production",
    "lint": "nx run-many -t lint",
    "typecheck": "tsc -p apps/windhawk-frontend/tsconfig.app.json --noEmit",
    "build-css": "less-watch-compiler --enable-js --run-once --main-file=app.dark.less apps/windhawk-frontend/src/app/ apps/windhawk-frontend/src/app/ && less-watch-compiler --enable-js --run-once --main-file=app.light.less apps/windhawk-frontend/src/app/ apps/windhawk-frontend/src/app/",
    "watch-css": "npm run build-css && concurrently \"less-watch-compiler --enable-js --main-file=app.dark.less apps/windhawk-frontend/src/app/ apps/windhawk-frontend/src/app/\" \"less-watch-compiler --enable-js --main-file=app.light.less apps/windhawk-frontend/src/app/ apps/windhawk-frontend/src/app/\""
  },
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@windhawk/webview-ipc-contract": "file:../windhawk-webview-ipc-contract",
    "antd": "^4.24.16",
    "core-js": "^3.49.0",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^4.0.1",
    "immer": "^11.1.15",
    "js-yaml": "^5.2.2",
    "monaco-editor": "^0.56.0",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react": "18.3.1",
    "react-diff-view": "^3.3.3",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.11",
    "react-infinite-scroll-component": "^7.2.1",
    "react-is": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "regenerator-runtime": "0.14.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "6.4.4",
    "swr": "^2.4.2",
    "tslib": "^2.8.1",
    "unidiff": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@nx/cypress": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-is": "18.3.1",
    "@types/styled-components": "5.1.36",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-jest": "30.4.1",
    "babel-plugin-styled-components": "2.3.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "cypress": "^15.19.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
